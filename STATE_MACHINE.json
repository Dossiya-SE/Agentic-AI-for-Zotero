  "transitions": [
    {"from":"SOURCE_UNFROZEN","to":"SOURCE_FROZEN","requires":["identity","attachment","PDF SHA","page labels"]},
    {"from":"SOURCE_FROZEN","to":"SCIENTIFIC_EXTRACTION_COMPLETE","requires":["full-text review","candidate evidence inventory","background/focal separation"]},
    {"from":"SCIENTIFIC_EXTRACTION_COMPLETE","to":"SCIENCE_ADJUDICATED","requires":["focality","atomicity","role","downstream-use","provenance","decision-scope adjudication"]},
    {"from":"SCIENCE_ADJUDICATED","to":"SCIENCE_HUMAN_APPROVED","requires":["explicit scientific approval"]},
    {"from":"SCIENCE_HUMAN_APPROVED","to":"CANONICALIZED","requires":["semantic deduplication","body/appendix/abstract/conclusion preference","conflict governance","one terminal evidence state per candidate"]},
    {"from":"CANONICALIZED","to":"GOLD_FROZEN","requires":["gold-visible set frozen","ledger/context/conflict layers separated","all INPUT consumed_by edges","all quantified sustainability outcomes generated_by or NOT_REPORTED","all provenance resolved"]},
    {"from":"GOLD_FROZEN","to":"GEOMETRY_FROZEN","requires":["exact text/region geometry","native equation regions","mixed-surface segmentation","visual QA"]},
    {"from":"GEOMETRY_FROZEN","to":"FINAL_TARGET_SET_FROZEN","requires":["redundancy recheck","target count conservation","no unresolved blockers"]},
    {"from":"FINAL_TARGET_SET_FROZEN","to":"SCHEMA_FROZEN","requires":["permanent EvidenceID","target fingerprints","transaction action plan"]},
    {"from":"SCHEMA_FROZEN","to":"SCHEMA_HUMAN_APPROVED","requires":["schema hash-bound approval"]},
    {"from":"SCHEMA_HUMAN_APPROVED","to":"DRYRUN_CERTIFIED","requires":["writer dry-run","independent auditor dry-run","negative regression suite"]},
    {"from":"DRYRUN_CERTIFIED","to":"PREMUTATION_CERTIFIED","requires":["full authority chain pass","paper readiness GOLD_FROZEN+GEOMETRY_FROZEN+QA_PASS"]},
    {"from":"PREMUTATION_CERTIFIED","to":"MUTATION_AUTHORIZED_SINGLE_USE","requires":["explicit hash-bound mutation authorization"]},
    {"from":"MUTATION_AUTHORIZED_SINGLE_USE","to":"TRANSACTION_IN_PROGRESS","requires":["fresh prewrite","sync lock","second prewrite","rollback snapshot","precommit keys","authorization consumption","live-state hash unchanged"]},
    {"from":"TRANSACTION_IN_PROGRESS","to":"TRANSACTION_COMMITTED_PENDING_AUDIT","requires":["exact paper-atomic transaction success"]},
    {"from":"TRANSACTION_IN_PROGRESS","to":"TRANSACTION_ROLLED_BACK_AUTH_CONSUMED","requires":["successful rollback","prewrite fingerprint restored"]},
    {"from":"TRANSACTION_IN_PROGRESS","to":"CRITICAL_PARTIAL_STATE","requires":["rollback incomplete"]},
    {"from":"TRANSACTION_COMMITTED_PENDING_AUDIT","to":"POSTWRITE_CERTIFIED","requires":["independent read-only audit","exact target/live correspondence"]},
    {"from":"POSTWRITE_CERTIFIED","to":"IDEMPOTENT","requires":["NOOP=N","CREATE=UPDATE=REPLACE=DELETE=0"]},
    {"from":"IDEMPOTENT","to":"FINAL_RELEASE_FROZEN","requires":["final package audit","release manifest"]}
  ],
